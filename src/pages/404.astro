---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
---
<Base title="Page not found">
  <section class="page-hero" style="min-height:60vh;display:grid;place-items:center">
    <div class="container">
      <span class="bubble" style="--s:90px;margin:0 auto 1.5rem"></span>
      <h1>Oops — this bubble popped!</h1>
      <p>We couldn’t find that page, but we can get you back to the fun.</p>
      <p style="margin-top:1.5rem"><a class="btn" href={href('/')}>Back to home</a></p>
    </div>
  </section>
</Base>
